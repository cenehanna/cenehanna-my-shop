generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// 1. КОРИСТУВАЧІ (З датасету customers.csv)
// -----------------------------------------------------------------------------
model User {
  id                   String        @id @default(uuid())
  customerId           String        @unique @map("customer_id") // Оригінальний customer_id з H&M (hash)
  age                  Int?
  clubMemberStatus     String?       @map("club_member_status")
  fashionNewsFrequency String?       @map("fashion_news_frequency")
  postalCode           String?       @map("postal_code")
  createdAt            DateTime      @default(now()) @map("created_at")

  cartItems            CartItem[]
  favorites            Favorite[]    // Необхідно для Content-Based Filtering & Cosine Similarity
  transactions         Transaction[] // Історія покупок для Collaborative Filtering & Cosine Similarity

  @@map("users")
}

// -----------------------------------------------------------------------------
// 2. КАТЕГОРІЇ (З articles.csv: index_group_name -> product_group_name -> product_type_name)
// -----------------------------------------------------------------------------
model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique

  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryToCategory")

  products Product[]

  @@index([parentId])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// 3. ТОВАРИ (З articles.csv)
// -----------------------------------------------------------------------------
model Product {
  id          String   @id @default(uuid())
  articleId   BigInt   @unique @map("article_id") // Унікальний article_id з H&M (потрібен для шляху до зображення)
  productCode Int      @map("product_code")      // Ідентифікатор базової моделі одягу
  parentId    String?  @map("parent_id")
  parent      Product? @relation("ProductVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants    Product[] @relation("ProductVariants")

  title       String
  slug        String   @unique
  price Decimal @db.Decimal(10, 2)
  images      String[] // Масив із 1 елементом: ["/images/010/0108775015.jpg"]

  description String?  @db.Text
  badges      String[] // Можна заповнити кольором, типом малюнка або відділом (напр. ["Black", "Solid"])

  // Метадані для Content-Based Filtering (пошук за схожими атрибутами)
  productTypeName       String @map("product_type_name")
  productGroupName      String @map("product_group_name")
  graphicalAppearanceName String @map("graphical_appearance_name")
  colourGroupName       String @map("colour_group_name")
  perceivedColourValueName String @map("perceived_colour_value_name")
  sectionName           String @map("section_name")
  garmentGroupName      String @map("garment_group_name")

  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  cartItems    CartItem[]
  favorites    Favorite[]
  transactions Transaction[]

  @@index([categoryId])
  @@index([createdAt(sort: Desc)])
  @@index([price])
  @@index([productCode])
  @@index([parentId])
  @@map("products")
}

// -----------------------------------------------------------------------------
// 4. КОШИК ТА ОБРАНЕ (Для дій користувача в інтерфейсі та Content-Based Filtering)
// -----------------------------------------------------------------------------
model CartItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

// -----------------------------------------------------------------------------
// 5. ІСТОРІЯ ПОКУПОК / ТРАНЗАКЦІЇ (З transactions_train.csv)
// -----------------------------------------------------------------------------
// Це головне джерело даних для Collaborative Filtering & Cosine Similarity
model Transaction {
  id             String   @id @default(uuid())
  tDat           DateTime @map("t_dat")
  price Decimal @db.Decimal(10, 2)
  salesChannelId Int      @map("sales_channel_id")

  userId    String  @map("user_id")
  productId String  @map("product_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@map("transactions")
}